# R package development
/.Rhistory
/.RData
/.Rproj.user
*.Rproj
.Renviron
/msuiter.Rcheck/
/msuiter_*.tar.gz

# R build artifacts
/src/*.o
/src/*.so
/src/*.dll
/src/symbols.rds

# Rust
/src/rust/target/
/src/rust/vendor/
/src/rust/vendor.tar.xz
/src/.cargo
/src/rust/.cargo
target/

# Generated by configure (from src/Makevars.in), removed by `cleanup`
/src/Makevars
/src/Makevars.win

# docs build (the pkgdown output root; the former docs/ corpus moved to
# vignettes/ -- the site itself is built and published by .github/workflows/pkgdown.yaml)
/docs/
/pkgdown/_site/

# data scratch
*.RData
*.rds.tmp

# OS
.DS_Store

# benchmark outputs
/bench/cache/
/bench/results/*.csv

# Calibrator probe working dirs (audit #74 P0, 2026-11-04): the p7cap
# campaigns write per-probe probe_cache trees under <campaign>/_scratch/
# (4.3M in the 20261104T093543Z face). They are the re-derivable working
# class -- the committed face of a campaign is CALIBRATION.json +
# anchors_fragment.json + witnesses/ only; the (AC)-law tests read the
# witnesses, never _scratch (proven: clean checkouts without _scratch
# run the full suite green once the witnesses are tracked).
/bench/results/**/_scratch/

# G0 harness: heavy intermediates stay out of git (results/ is tracked)
/bench/g0/cache/
/bench/**/__pycache__/
/tools/kl-crosscheck/driver/target/

# Dev-tool Python bytecode caches (tools/*.py helpers, once imported, emit
# __pycache__ next to their sources; pytest would emit .pytest_cache)
/tools/**/__pycache__/
/tools/**/.pytest_cache/

# P5 catalog-currency: the derived cache (source payloads + record) is a
# local, re-derivable artifact -- only the committed sidecar is versioned
/bench/catalog-currency/cache/

# sigminer runtime artifacts
/bench/xval-m2/sigminer-auto/

# NMF engine test artifacts
/tests/testthat/NMF_*/

# G0 results are regenerated artifacts
/bench/g0/results/

# instrumented covr-lane byproducts: gcov counters and in-place vignette renders
/src/*.gcno
/src/*.gcda
/vignettes/*.html
bench/scenarios/out/fixture/

# U-M7-02 competitor image: SigMiner CRAN 2.3.1 (design memo §2a/§5/§10.1).
#
# NETWORK POLICY (memo §5, binding): every base pull spells the mirror host
# explicitly — docker.io is served by 9f6c5in3dh5vszgdz0.xuanyuan.run.
# Direct upstream pulls fail on this network (proxy 407) and are prohibited;
# a 407 is recorded as environmental evidence, never routed around.
#
# Build (context = bench/m7/adapters):
#   docker build -f Dockerfile.sigminer -t m7-sigminer:cr2.3.1 .
# After a verified build the harness captures `docker image inspect`
# RepoDigests into competitors/registry.py (PENDING-VERIFY → sha256:...);
# inventing a digest is prohibited (§5 ii).
#
# STRUCTURAL NOTE (supersedes the old QUOTING NOTE): the build script is a
# COPY'd file, not an Rscript -e one-liner. Whether Dockerfile line
# continuations preserve newlines inside quoted content is parser-dependent,
# and one swallowed newline after "#" silently commented out the rest of the
# build script (including the pin/export asserts at its tail). A file copy
# removes that hazard class entirely; build rationale lives in these
# Dockerfile-level comments and in install_sigminer.R's header.
FROM 9f6c5in3dh5vszgdz0.xuanyuan.run/rocker/r-ver:4.3.3

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates cmake \
    && rm -rf /var/lib/apt/lists/*

# Second recorded build defect (verbatim, attempt 2, 2026-10-08): the CRAN
# Rhtslib 2.2.x sources build their bundled BGZF/HTS code against system
# headers and died with "bgzf.c:38:10: fatal error: zlib.h: No such file or
# directory" on the r-ver base, which ships the runtime zlib1g but not the
# -dev headers; the CRAN-only repos override fixed *which* Rhtslib resolves
# (no more Bioconductor 3.17 archive), but the compile needs the headers.
# zlib1g-dev plus the bz2/lzma headers the bundled HTSlib probes for are the
# provisioning fix; a separate RUN keeps the (already proxy-survived) apt
# layer above cached, minimizing the fresh .deb fetch surface (§9b 502s).
# Third recorded build defect (verbatim, rebuild 2, 2026-10-08): the same
# header class then hit the curl side of the pinned RBibUtils sources —
# "hfile_libcurl.c:47:10: fatal error: curl/curl.h: No such file or
# directory" — so curl dev headers join this layer (memo §9b item 4).
# Fifth recorded build defect (verbatim, closure attempt 1, 2026-10-08): the
# bare name is not installable on this jammy base — "Package libcurl-dev is
# a virtual package provided by: libcurl4-openssl-dev ... E: Package
# 'libcurl-dev' has no installation candidate" — so the concrete openssl-
# backed provider is pinned, matching the runtime libcurl4-openssl the
# distro already ships (memo §9b closure addendum).
RUN apt-get update \
    && apt-get install -y --no-install-recommends zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# CRAN package installs follow the G0-established idiom (memo §8): §5 governs
# image pulls, not in-build package fetches. The pin is the CRAN archive
# version 2.3.1 (the exact artifact the host-library xval anchor cross-
# validates against, memo §2a note).
#
# SLICE-2 CLOSURE (2026-10-08, memo §9c): the recorded fourth-through-
# seventh-defect chain (Archive-only 404s, the warning-not-error ==spec
# contract, the tree-wide era-pinned-Import 404/SSL class) is closed here.
# The ==spec + remotes::install_version + hand-pinned ensure.pin path was
# retired because the ground truth proved it non-viable on this base R: the
# "pkg==ver" string is looked up VERBATIM AS A PACKAGE NAME ("package
# 'rbibutils==2.4.1' is not available for this version of R" — the recorded
# seventh defect) and install.packages carries no archiveurl parameter at all
# (slice-2 probe 1). The build now runs install_sigminer.R: a whole-tree,
# result-gated, Archive-aware resolver — every transitive node of sigminer
# 2.3.1 resolves through CRAN contrib -> Archive(per-pkg dir) -> Archive
# (flat) -> the pinned Bioconductor 3.17 contrib, with name-case candidates
# [db-canonical | Archive-index-alias | as-written | lowercase | capitalized],
# per-URL retries against the recorded proxy flakiness (§9b item 1), and an
# Archive-listing walk (plus master-index canonical discovery) as last
# resort. The Bioconductor layer is load-bearing and recorded as such: the
# sigminer Imports maftools/Rhtslib exist on NO CRAN tree (contrib-db miss +
# the 28k-token Archive master index has no directory — probes 3/6), and the
# bioc 3.17 release is the same source the recorded pre-hardening build
# compiled Rhtslib from (second defect above: the -dev headers provision it).
# A node counts as provisioned only when the library's own DESCRIPTION
# reports the version — the recorded result-gate semantics, now the design
# itself. The seventh defect's belt-and-braces pins (rbibutils 2.4.1,
# gridBase 0.4-7) are kept, result-gated through the same fetch path.
#
# The recorded build-time asserts are preserved in the script's tail:
# packageVersion("sigminer")=="2.3.1" exact plus the WITNESSED NAMESPACE
# contract (slice-3, memo §9c.2/§9d): the export set parsed from the
# resolver's own downloaded tarball bytes behind a sha256 tripwire, with the
# core bp_*/sig_* extraction family function-asserted — any drift stops the
# build loudly (G0 build-guard idiom). The old five "documented exports"
# were fiction (0/5 in the witness) and are retired with a ledger entry.
COPY install_sigminer.R /tmp/install_sigminer.R
RUN Rscript /tmp/install_sigminer.R

WORKDIR /work
COPY m7_entry.py /work/
COPY run_sigminer.R /work/
# RB-01 (2026-10-09): the pilot's exit-127 catch -- the cell protocol's own
# measurement wrapper (m7_entry.py, ENTRY_SCRIPT in competitors/docker_cmd.py)
# is python and the registry launches it via entrypoint="python3", but the
# r-ver base carries no interpreter at all: no python3, no python on PATH.
# Single-purpose delta per the controller's scope-frozen ruling: provision
# exactly that interpreter and nothing else (no base move, no R pin move, no
# layer reshuffle; appended last so every cached layer above stays warm).
# Witness gate: tools/probe_sigminer_cell_argv.py must run the REAL cell argv
# to sidecar-schema-valid depth GREEN against this image before the registry
# flip; the RED witness vs slice3-r2 is committed next to the records.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
# RB-03 (2026-10-09): convergence-gate closure -- the executed-surface audit
# (tools/audit_executed_surface_deps.py, suite group (M)) found run_sigminer.R's
# library(jsonlite) (single call site: fromJSON at L85) uncovered by the recipe;
# the slice3-r3 witness died exactly there. Provisioned through the recipe's own
# CRAN idiom (install_sigminer.R CRAN/CONTRIB host) with the build9 result-gate
# discipline: the layer fails loudly unless the installed library's own
# DESCRIPTION reports a version. Controller-ruled scope, one build, spent on the
# COMPLETE audited closure -- never iteratively.
RUN Rscript -e 'options(repos = c(CRAN = "https://cran.r-project.org")); install.packages("jsonlite"); v <- packageVersion("jsonlite"); if (is.null(v)) quit(status = 1L); cat("[image] jsonlite ", as.character(v), "provisioned\\n")'
# RB-05 (2026-10-09), controller-instrumented class-(d) closure, ledger 1/1.
# The r4 probe forensics (committed witnesses: cell_argv_probe_slice3-r4_
# DEFECT.json, rehearse_manifest under bench/results/docker_m7_PILOT_20261008-
# 200152/rehearsal_slice3-r4/) established three facts this delta answers:
# (1) the committed run_sigminer.R L44 called commandArgs with a second,
#     never-witnessed argument — era R 4.3.3 formals are {trailingOnly}
#     alone (formals_allowlist_slice3-r4.json, harvested from this image's
#     own R; controller host probe on R 4.5.2 agrees; the line's provenance
#     stays an unverified inference);
# (2) the frozen default extraction path hard-requires three Suggests-level
#     packages the declared DESCRIPTION closure never promises:
#     lpSolve (best_practice_helper.R lp.assign step), synchronicity
#     (best_practice.R namespace load), matrixStats (the resampling step,
#     found in the zero-build rehearsal loop and folded per RB-04(4) --
#     the stage2 auto-install URLs witness its era version 1.3.0 verbatim);
#     the runB witness shows R otherwise AUTO-INSTALLS them mid-measurement
#     (network, nondeterministic, one SSL-death recorded);
# (3) a green build that never executed its own measurement path is not
#     admissible evidence (r4 built GREEN and probed DEFECT).
# Layers below are the ruling's scope-frozen answer: byte-pinned COPY
# assertion, era/version-gated bakes (literal repos, literal versions --
# drift is a build death, never a silent float), and a network-none
# self-witness replaying the zero-touch composed argv over the stage2-run
# fixture bytes.
RUN test "$(sha256sum /work/run_sigminer.R | cut -d' ' -f1)" = "7f30673847d96cd0e0fbfd1763e89ad12b1e5212c0152db4dd20741a2a750084" || (echo "[FATAL] run_sigminer.R bytes diverge from the stage2-proven rehearsal witness" >&2; exit 1)
RUN Rscript -e 'options(repos = c(P3M = "https://p3m.dev/cran/2024-04-23", CRAN = "https://cran.r-project.org")); install.packages(c("lpSolve", "synchronicity"), dependencies = NA, quiet = TRUE); v1 <- packageVersion("lpSolve"); v2 <- packageVersion("synchronicity"); if (is.null(v1) || as.character(v1) != "5.6.20") quit(status = 1L); if (is.null(v2) || as.character(v2) != "1.3.10") quit(status = 1L); cat("[image] lpSolve ", as.character(v1), ", synchronicity ", as.character(v2), " provisioned\\n")'
RUN Rscript -e 'options(repos = c(P3M = "https://p3m.dev/cran/2024-04-23")); install.packages("matrixStats", dependencies = NA, quiet = TRUE); v3 <- packageVersion("matrixStats"); if (is.null(v3) || as.character(v3) != "1.3.0") quit(status = 1L); cat("[image] matrixStats ", as.character(v3), " provisioned\\n")'
COPY mini_cell/ /work/mini/in/
COPY self_witness.sh /tmp/self_witness.sh
# The four-file trust guard at container scope: intervals/errors/timing are
# the container-side productions asserted here (plus the sidecar schema and
# rc 0); manifest.json is host-side by contract (run_bench.py writes it) and
# the matrix re-asserts the full four. Pre-baked rehearsal of THIS layer,
# identical posture (network-none, deps mounted via R_LIBS_USER -- the
# Linux search-path variable; R_LIB_USER is Windows-only and was the reason
# the stage2 run self-healed via auto-install): selfwitness_prebake2 in the
# pilot manifest, 0 auto-install lines, NMF suggested result 95.5 verbatim.
RUN --network=none sh /tmp/self_witness.sh
# The harness always invokes python3 /work/m7_entry.py ... -- Rscript
# /work/run_sigminer.R ... (adapters/docker_cmd.py ENTRY_SCRIPT); CMD is
# documentation of that shape only.
CMD ["python3", "/work/m7_entry.py"]

# P6 yardstick image: the seventh bake (manifest :42, :92 "python-capable;
# only if wheel attempt proceeds" -- 04-nmf-rs-fetch-probe RESOLVED-FETCHABLE,
# so it proceeds). The rust-NMF@nmf-rs wheel and R NMF::nmf(brunet) meet on
# one committed fixture inside one image; run_nmf_yardstick.py is the entry.
#
# NETWORK POLICY (memo §5, binding): the base pull spells the mirror host --
# docker.io is served by 9f6c5in3dh5vszgdz0.xuanyuan.run; a direct upstream
# pull fails (proxy 407) and is prohibited. In-build package fetches
# (apt/CRAN/PyPI) follow the G0-established §8 idiom: §5 governs image
# pulls, not fetches. The PyPI leg spells the UPSTREAM index explicitly
# because the network-configured mirror does not sync nmf-rs (probe bytes in
# 04-nmf-rs-fetch-probe-20261015); a blocked index or a hash mismatch is a
# build death, never a silent fallback.
#
# Build (driver: tools/p6_build_yardstick.py assembles the context; digest
# captured from inspect .Id -- SS3, never transcribed):
#   context = {run_nmf_yardstick.py, run_nmf_yardstick_leg.R,
#              yardstick_cell/matrix.csv, Dockerfile.nmf_yardstick}
FROM 9f6c5in3dh5vszgdz0.xuanyuan.run/rocker/r-ver:4.3.3

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# The R face: NMF (Brunet et al.) -- the reference core the paper measures
# against. Death #8: a CRAN-only install.packages("NMF") dies, because NMF
# Imports Biobase, which exists on no CRAN tree (probes 3/6). Provisioning
# therefore runs the committed, result-gated resolver install_nmf_yardstick.R
# -- hand-read contrib index (R's repo machinery fetches zero rows from this
# host), index-spelled tarballs, per-URL retries (§9b), library-DESCRIPTION
# verdicts, and hard version gates NMF 0.28 / Biobase 2.60.0. The
# [yardstick-provision] echoes are the layer's version attestation; absence
# or drift is a build death.
COPY install_nmf_yardstick.R /tmp/install_nmf_yardstick.R
RUN test "$(sha256sum /tmp/install_nmf_yardstick.R | cut -d' ' -f1)" = \
      "5054fc5ffe386a1db20df59141e29fe9d96ce788f109669f7a411b4058d88579" \
    || (echo "[FATAL] install_nmf_yardstick.R bytes diverge from the committed resolver" >&2; exit 1)
RUN Rscript /tmp/install_nmf_yardstick.R

# The rust face: single-package, binary-only, and hash-gated on the
# execution-arch wheel -- the shape the fetch probe itself measured (death
# #9, 2026-10-16): Ubuntu jammy's pip 22.0.2 exposes --require-hashes as a
# no-value flag (both CLI value forms rejected in-container), so the pin
# rides a hard sha256sum test against the banked 04-nmf-rs-fetch-probe
# bytes between download and an OFFLINE (--no-index --find-links) install:
# a digest mismatch dies at the gate, never at import time. --no-deps
# carries both roles it always had: no resolve sweep, and the promise that
# the numpy below (jammy apt, 1.21) is the one the abi3 wheel loads. The
# six arm images are linux/arm64 (inspect .Architecture) -- the wheel is the
# aarch64 build, 9ad81407...; the x86_64 93608cb2... stays banked as fetch
# evidence, not as this image's artifact. The index stays spelled upstream:
# the configured mirror does not sync nmf-rs.
RUN python3 -m pip download --no-deps --no-cache-dir --only-binary :all: \
      --index-url https://pypi.org/simple -d /tmp/nmf_rs_wheel \
      "nmf-rs==0.1.0" \
    && test "$(sha256sum /tmp/nmf_rs_wheel/nmf_rs-0.1.0-cp39-abi3-manylinux_2_28_aarch64.whl | cut -d' ' -f1)" = \
         "9ad81407bbc9335219f31a0b6746264761733494c6b16697e060729fa749dd17" \
      || (echo "[FATAL] nmf-rs wheel digest diverges from the banked fetch evidence" >&2; exit 1) \
    && python3 -m pip install --no-deps --no-cache-dir --no-index \
         --find-links /tmp/nmf_rs_wheel "nmf-rs==0.1.0" \
    && rm -rf /tmp/nmf_rs_wheel

WORKDIR /work
COPY run_nmf_yardstick.py /work/
RUN test "$(sha256sum /work/run_nmf_yardstick.py | cut -d' ' -f1)" = \
      "03f8c920e46a1b2f23a5216fae14e1349fcac3b00e92f648c37898ef46ac103f" \
    || (echo "[FATAL] run_nmf_yardstick.py bytes diverge from the committed runner" >&2; exit 1)
COPY run_nmf_yardstick_leg.R /work/
RUN test "$(sha256sum /work/run_nmf_yardstick_leg.R | cut -d' ' -f1)" = \
      "4a6cb9e7eea012620649745588399ceb716b5a9d3a84e02cb18919e43e3e25ef" \
    || (echo "[FATAL] run_nmf_yardstick_leg.R bytes diverge from the committed leg" >&2; exit 1)
COPY yardstick_cell/ /work/yardstick_cell/
RUN test "$(sha256sum /work/yardstick_cell/matrix.csv | cut -d' ' -f1)" = \
      "10bda6beb4f457fa7f8b64e2030a05fa3cbe60c1251eb8bbfad14108a24601ae" \
    || (echo "[FATAL] yardstick fixture bytes diverge from the committed matrix" >&2; exit 1)

# Self-witness under network-none (arm-witness idiom): both cores must load
# and complete a fixed five-iteration brunet run with no network at all.
# An undeclared runtime dependency dies HERE, never mid-measurement.
RUN --network=none python3 -c 'import numpy as np, nmf_rs; r = nmf_rs.nmf(np.random.default_rng(1).random((8, 6)), 2, method = "brunet", seed = 1, max_iter = 5, stop = "max_iter"); assert r.n_iter == 5; print("[image] nmf-rs smoke ok (5 iterations, network-none)")'
RUN --network=none Rscript -e 'suppressMessages(library(NMF)); set.seed(1L); v <- matrix(abs(rnorm(24)), 6); r <- NMF::nmf(v, 2L, method = "brunet", nrun = 1L, seed = 1L, maxIter = 5L, eps = -Inf); if (!is(r, "NMFfit") || !identical(NMF::niter(r), 5L)) quit(status = 1L); cat("[image] NMF smoke ok (5 iterations, network-none)\n")'

# The yardstick invocation shape (measured outdir path supplied per cell):
#   docker run --rm --network=none <image> \
#     python3 /work/run_nmf_yardstick.py --out /work/yardstick.json
CMD ["python3", "/work/run_nmf_yardstick.py"]
